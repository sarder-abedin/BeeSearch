# ─────────────────────────────────────────────────────────────
#  BeeSearch — Environment Configuration
#
#  HOW TO USE:
#    cp .env.example .env
#    Edit .env with your settings
# ─────────────────────────────────────────────────────────────

# ── Local LLM ────────────────────────────────────────────────
# Must match a model pulled with `ollama pull <model>`
#   llama3.2:3b      2 GB   32k ctx   fast, low-RAM
#   llama3.1:8b      5 GB   32k ctx   recommended
#   mistral-nemo:12b 7 GB  128k ctx   long documents (needs 16 GB RAM)
#   phi4:14b         9 GB   16k ctx   highest reasoning quality
OLLAMA_MODEL=llama3.2:3b
NUM_CTX=32768

# ── Ollama server URL ─────────────────────────────────────────
# Manual install: leave as localhost
# Docker: overridden automatically by docker-compose.yml
OLLAMA_BASE_URL=http://localhost:11434

# ── Research Notebook response tuning ─────────────────────────
# How "creative" vs. "literal" Chat answers, summaries, and explanations
# are. One of: precise | focused | balanced | creative
#   precise  — fully deterministic, same answer every time
#   focused  — BeeSearch's default tuning (recommended)
#   balanced — more natural, varied phrasing
#   creative — most varied/exploratory wording (Explain, podcast, mind maps)
# Grading and fact-checking always stay deterministic, regardless of level.
# Changeable anytime in the UI sidebar or via /temperature <level> in the CLI.
TEMPERATURE_LEVEL=focused

# ── Web app port (docker-compose only) ───────────────────────
PORT=8000

# ── Academic APIs (all free) ──────────────────────────────────
SEMANTIC_SCHOLAR_API_KEY=
SEMANTIC_SCHOLAR_BASE_URL=https://api.semanticscholar.org/graph/v1
CROSSREF_BASE_URL=https://api.crossref.org/works
CROSSREF_EMAIL=your@email.com
ARXIV_MAX_RESULTS=10

# ── Hybrid RAG ────────────────────────────────────────────────
EMBED_MODEL=nomic-embed-text
CHROMA_PERSIST_DIR=./outputs/chroma_db
HYBRID_TOP_K=8

# ── Document chunking ─────────────────────────────────────────
CHUNK_SIZE=800
CHUNK_OVERLAP=150
MAX_DOCUMENT_CHUNKS=500
MAX_SEARCH_RESULTS=8

# ── Large document handling ───────────────────────────────────
# PDFs with more pages than this threshold auto-switch from Docling
# (ML models, ~500 MB RAM) to pdfplumber (streaming, low RAM).
# Lower this value on machines with < 8 GB RAM (e.g. 20 or 30).
# Set to 0 to always use Docling regardless of size.
LARGE_DOC_PAGE_THRESHOLD=50

# ── Google Search microservice (optional) ─────────────────────
GOOGLE_SEARCH_SERVICE_URL=http://localhost:8000

# ── Output ────────────────────────────────────────────────────
OUTPUT_DIR=./outputs
LOG_LEVEL=INFO

# ── Vision model for figure captioning (optional) ────────────────────────────
# Set to an Ollama vision model to enable automatic captioning of figures
# (charts, diagrams, photos) found in uploaded PDFs.
# Supported models (pull first): llava:7b, llama3.2-vision:11b, minicpm-v:8b
# Leave blank (default) to skip figure extraction entirely — no overhead.
#   ollama pull llava:7b
VISION_MODEL=

# ── Langfuse LLM Observability (optional) ─────────────────────────────────────
# Traces every LLM call: prompts, completions, latency, token counts.
# Self-hosted: docker compose -f docker-compose.langfuse.yml up -d
#   Then open http://localhost:3000 → create account → Settings → API Keys
# Langfuse Cloud: set LANGFUSE_HOST=https://cloud.langfuse.com
# Leave blank to disable tracing entirely (no overhead, no errors).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
